<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DataWatcher Alert</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            margin: 0;
            padding: 20px;
            color: #333;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            background: white;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .header {
            background: #c0392b;
            color: white;
            padding: 24px 32px;
        }

        .header h1 {
            margin: 0;
            font-size: 22px;
        }

        .header p {
            margin: 6px 0 0;
            opacity: 0.85;
            font-size: 14px;
        }

        .body {
            padding: 28px 32px;
        }

        .meta {
            display: flex;
            gap: 24px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }

        .meta-item {
            padding: 10px;
        }

        .meta-label {
            font-size: 11px;
            text-transform: uppercase;
            color: #888;
            font-weight: bold;
            letter-spacing: 0.5px;
        }

        .meta-value {
            font-size: 15px;
            color: #333;
            margin-top: 2px;
        }

        .badge {
            display: inline-block;
            background: #e74c3c;
            color: white;
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: bold;
        }

        .message-box {
            background: #fef9e7;
            border-left: 4px solid #f39c12;
            padding: 12px 16px;
            border-radius: 4px;
            margin-bottom: 24px;
            font-size: 14px;
        }

        h2 {
            font-size: 16px;
            color: #555;
            margin: 0 0 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        thead tr {
            background: #2c3e50;
            color: white;
        }

        thead th {
            padding: 10px 12px;
            text-align: left;
            font-weight: normal;
        }

        tbody tr:nth-child(even) {
            background: #f9f9f9;
        }

        tbody tr:hover {
            background: #eaf0fb;
        }

        tbody td {
            padding: 9px 12px;
            border-bottom: 1px solid #eee;
            vertical-align: top;
        }

        .truncated {
            color: #888;
            font-style: italic;
            font-size: 12px;
            margin-top: 12px;
        }

        .footer {
            background: #f5f5f5;
            padding: 16px 32px;
            font-size: 12px;
            color: #999;
            border-top: 1px solid #eee;
        }
    </style>
</head>
<body>
<div class="container">

    <div class="header">
        <h1>⚠️ Data anomaly detected {{ appName ? 'on ' ~ appName : '' }}</h1>
        <p>DataWatcher — {{ "now"|date("d/m/Y H:i:s") }}</p>
    </div>

    <div class="body">
        <div class="meta">
            <div class="meta-item">
                <div class="meta-label">Check</div>
                <div class="meta-value"><strong>{{ check.name }}</strong></div>
            </div>
            <div class="meta-item">
                <div class="meta-label">Description</div>
                <div class="meta-value">{{ check.description }}</div>
            </div>
            <div class="meta-item">
                <div class="meta-label">Anomalies</div>
                <div class="meta-value"><span class="badge">{{ result.count }}</span></div>
            </div>
        </div>

        {% if result.message %}
            <div class="message-box">{{ result.message }}</div>
        {% endif %}

        {% if result.rows is not empty %}
            {% set columns = result.columns is not empty ? result.columns : result.rows[0]|keys %}
            {% set maxRows = 50 %}

            <h2>Concerned records</h2>
            <table>
                <thead>
                <tr>
                    {% for col in columns %}
                        <th>{{ col }}</th>
                    {% endfor %}
                </tr>
                </thead>
                <tbody>
                {% for row in result.rows|slice(0, maxRows) %}
                    <tr>
                        {% for col in columns %}
                            <td>{{ row[col] ?? '—' }}</td>
                        {% endfor %}
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            {% if result.count > maxRows %}
                <p class="truncated">
                    ... and {{ result.count - maxRows }} additional record(s) not displayed.
                </p>
            {% endif %}
        {% endif %}
    </div>

    <div class="footer">
        This message was automatically generated by DataWatcher. Please do not reply to this email.
    </div>
</div>
</body>
</html>
